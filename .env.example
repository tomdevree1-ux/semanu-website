# ─────────────────────────────────────────────────────────────
# semanu.eu: environment variables
# Local: copy to `.env.local`. Server: /etc/semanu-eu/live.env and acc.env
# (see deploy/README-DEPLOY.md). Never commit real env files.
# ─────────────────────────────────────────────────────────────

# Environment. "production" only on www.semanu.eu. Anything else (staging,
# local) is noindex and posts leads to the SEMANU staging Supabase project.
# Read at BUILD time (robots, headers, metadata) and at run time.
SITE_ENV="staging"

# Public origin of this environment, no trailing slash. Read at build time.
#   live:    https://www.semanu.eu
#   staging: https://acc.semanu.eu
NEXT_PUBLIC_SITE_URL="https://acc.semanu.eu"

# Contact + analysis form → SEMANU edge function submit-contact.
# The URL defaults to the SEMANU prod project (SITE_ENV=production) or the
# staging project (otherwise); override only if needed.
# SEMANU_SUPABASE_URL="https://kiiyvctcfvfrivpjsfjo.supabase.co"
# Public anon (publishable) key of the matching SEMANU Supabase project
# (Supabase → Project Settings → API). Not a secret, but kept out of the code.
SEMANU_SUPABASE_ANON_KEY=""

# Spam protection (Cloudflare Turnstile, optional; forms work without it)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Analytics: Google Analytics 4 + Google Ads (load only after cookie consent).
# Empty = no Google tags at all.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""

# Google Search Console HTML-tag verification (content of the meta tag). Empty = none.
NEXT_PUBLIC_GSC_VERIFICATION=""

# cal.com booking link for "book a call" buttons (part after cal.com/).
# Empty = those buttons link to the contact page.
NEXT_PUBLIC_CAL_LINK=""

# IndexNow key (scripts/indexnow-ping.mjs). Must match public/<key>.txt.
INDEXNOW_KEY=""

# Error tracking (Sentry), optional; ships dark without a DSN.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
