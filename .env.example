# ─────────────────────────────────────────────────────────────
# amai.ch — environment variables
# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-publishable-key"
# Server-only. Used by API routes to insert leads bypassing RLS. NEVER expose to the client.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# Transactional email (choose one provider; Resend shown)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxx"
LEAD_NOTIFICATION_TO="hello@amai.ch"
LEAD_NOTIFICATION_FROM="amai.ch <noreply@amai.ch>"

# Spam protection (Cloudflare Turnstile — optional but recommended)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Stripe (Dashboard → Developers → API keys). See STRIPE_SETUP.md for full setup.
# Server-only secret. NEVER expose to the client.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxx"
# Server-only. Signing secret of the checkout/subscription webhook endpoint.
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxx"
# Price ids (created in Stripe). Plans are monthly recurring; the add-on is one-time.
STRIPE_PRICE_STARTER="price_xxxxxxxxxxxxxxxxx"      # 35 CHF / month, recurring
STRIPE_PRICE_BUSINESS="price_xxxxxxxxxxxxxxxxx"     # 79 CHF / month, recurring
STRIPE_PRICE_WEBSHOP="price_xxxxxxxxxxxxxxxxx"      # 99 CHF / month, recurring
STRIPE_PRICE_LOGO="price_xxxxxxxxxxxxxxxxx"         # 375 CHF (50% promo; 750 regular), one-time
STRIPE_PRICE_GOOGLE_ADS="price_xxxxxxxxxxxxxxxxx"   # 200 CHF / month, recurring add-on

# Site
NEXT_PUBLIC_SITE_URL="https://amai.ch"

# Order flow: "request" (enquiry email to hello@amai.ch, no payment) or "stripe"
# (live Stripe Checkout). Defaults to "request".
ORDER_FLOW_MODE="request"

# Admin area (/admin) — single password gate. Set a strong secret in Vercel.
ADMIN_PASSWORD=""

# Analytics — Google Analytics 4 (loads only after cookie consent = "all")
NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Google Ads conversion tag (gtag "AW-…"). Loads with GA4 from the same gtag.js;
# ad signals fire only after cookie consent = "all". Falls back to the live id in code.
NEXT_PUBLIC_GOOGLE_ADS_ID="AW-XXXXXXXXXX"

# Error tracking (Sentry) — optional; ships dark without a DSN. See OBSERVABILITY.md.
# Server DSN (Sentry project → Settings → Client keys / DSN). Empty = no events sent.
SENTRY_DSN=""
# Public DSN for browser capture (same value is fine). Exposed to the client by design.
NEXT_PUBLIC_SENTRY_DSN=""

# Ops secrets
# Guards the outbox cron route (Vercel Cron sends it as a Bearer token). Empty = route locked.
CRON_SECRET=""
# Server-only pepper for hashing rate-limit identifiers (IP/email are never stored raw).
RATE_LIMIT_SALT=""

# ── Email engagement tracking (P16 / WAF-3.1, Resend webhook) ────────────────
# Master switch for the /api/webhooks/resend route. Default off → the route no-ops (200 ignored). Ships dark.
# Enable only after the combined P14+P15 live smoke passes and the webhook is registered in Resend.
ENABLE_RESEND_WEBHOOK="false"
# Server-only. The Resend (Svix) webhook signing secret (Resend Dashboard → Webhooks → your endpoint).
# Empty = every event is unverifiable → the route returns 400 and processes nothing. NEVER expose to the client.
RESEND_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxx"
# Opens/clicks are unreliable tracking-pixel signals and privacy-sensitive → recorded only when this is "true"
# (default off). delivered/bounced/complained are recorded whenever ENABLE_RESEND_WEBHOOK is on. When on, only
# timestamps + counts are stored (no IP, no user-agent, no raw payload).
ENABLE_EMAIL_OPEN_CLICK_TRACKING="false"

# ── Follow-up worklist (P17 / WAF-3.2) ───────────────────────────────────────
# Internal read-only follow-up worklist + engagement insights at /app/.../follow-ups. Default off (ships dark).
# Pure read; reuses website_reports.read (view) + website_reports.deliver (inline follow-up). No migration/secret.
ENABLE_FOLLOWUP_WORKLIST="false"
