# semanu.eu on the SEMANU Hetzner server (2.31.50.26).
# Install: cp deploy/Caddyfile /etc/caddy/Caddyfile && caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
# Staging (acc) is public without a password; it is kept out of search engines.

{
	email hello@semanu.eu
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
		-Server
		-X-Powered-By
	}
	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Reverse proxy to a local Node service. No trusted_proxies anywhere: Caddy
# replaces any X-Forwarded-For the visitor sends, and X-Real-IP is overwritten
# with the TCP peer address. The app reads only X-Real-IP (src/lib/security/
# client-ip.ts) for its rate limit and forwards it to submit-contact.
# The forwarding headers for submit-contact are stripped so a visitor can never
# hand them to the app.
(node) {
	reverse_proxy 127.0.0.1:{args[0]} {
		header_up X-Real-IP {remote_host}
		header_up -X-Forward-Secret
		header_up -X-Visitor-IP
	}
}

# Live: canonical host.
www.semanu.eu {
	import common semanu-eu-live
	import node 3000
}

# Apex (and any other live alias) → www, permanently.
semanu.eu {
	redir https://www.semanu.eu{uri} permanent
}

# Staging: public but never indexed (noindex header + robots.txt Disallow).
acc.semanu.eu {
	import common semanu-eu-acc
	header X-Robots-Tag "noindex, nofollow"
	# No password on staging (decision Tom, October 2026); noindex stays.
	import node 3001
}
