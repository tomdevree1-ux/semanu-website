# semanu.eu on the SEMANU Hetzner server (2.31.50.26).
# Install: cp deploy/Caddyfile /etc/caddy/Caddyfile && caddy validate --config /etc/caddy/Caddyfile && systemctl reload caddy
# Staging password: /etc/caddy/staging-auth.caddy (generated from /etc/caddy/staging.hash,
# see deploy/README-DEPLOY.md). It never lives in this repo.

{
	email hello@semanu.eu
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		X-Frame-Options "SAMEORIGIN"
		-Server
		-X-Powered-By
	}
	# Hashed build assets never change: cache them for a year.
	@immutable path /_next/static/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	log {
		output file /var/log/caddy/{args[0]}.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Live: canonical host.
www.semanu.eu {
	import common semanu-eu-live
	reverse_proxy 127.0.0.1:3000
}

# Apex (and any other live alias) → www, permanently.
semanu.eu {
	redir https://www.semanu.eu{uri} permanent
}

# Staging: password first, never indexed.
acc.semanu.eu {
	import common semanu-eu-acc
	header X-Robots-Tag "noindex, nofollow"
	import /etc/caddy/staging-auth.caddy
	reverse_proxy 127.0.0.1:3001
}
