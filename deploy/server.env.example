# /etc/semanu-eu/live.env and /etc/semanu-eu/acc.env on the server (chmod 640, root:semanu-web).
# SITE_ENV, PORT and NODE_ENV are set in the systemd unit; do not repeat them here.

# Public anon key of the SEMANU Supabase project:
#   live.env → prod project bjpcgqejprkdqqohhere
#   acc.env  → staging project kiiyvctcfvfrivpjsfjo
SEMANU_SUPABASE_ANON_KEY=

# Cloudflare Turnstile secret (optional; the forms work without it).
TURNSTILE_SECRET_KEY=

# Sentry (optional).
SENTRY_DSN=
