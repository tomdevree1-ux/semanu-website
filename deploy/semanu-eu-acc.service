[Unit]
Description=semanu.eu Next.js server, acc.semanu.eu (staging)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=semanu-web
Group=semanu-web
WorkingDirectory=/srv/semanu-eu/acc/current
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=SITE_ENV=staging
Environment=PORT=3001
# 0.0.0.0, not 127.0.0.1: with 127.0.0.1 Next.js treats the locale rewrites of the
# i18n middleware as external and the pages hang. The port is not reachable from
# outside: ufw only allows 22, 80 and 443 (plus the Hetzner firewall).
Environment=HOSTNAME=0.0.0.0
Environment=NEXT_TELEMETRY_DISABLED=1
# Runtime settings (SEMANU_SUPABASE_ANON_KEY, TURNSTILE_SECRET_KEY, ...), filled by Tom on the server.
EnvironmentFile=/etc/semanu-eu/acc.env
Restart=always
RestartSec=3
# Hardening: read-only system, only the image cache is writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/semanu-eu/acc
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryMax=700M

[Install]
WantedBy=multi-user.target
